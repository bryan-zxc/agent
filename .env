# Backend Configuration
BACKEND_PORT=8001

# Frontend Configuration  
FRONTEND_PORT=3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Database Configuration
DATABASE_AUTO_MIGRATE=true

# PostgreSQL Configuration (non-sensitive defaults)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agent_user
POSTGRES_DB=agent_main
# POSTGRES_PASSWORD must be set in .env.local (not committed to git)

# Environment Settings
ENVIRONMENT=development
DEBUG_MODE=false

# MCP Feature Flags (safe defaults)
MCP_ENABLED=true
MCP_ROUTER_ENABLED=true
MCP_PLANNER_ENABLED=true
MCP_WORKER_ENABLED=false

# MCP Server Defaults (non-sensitive)
MCP_GITHUB_ENABLED=false
MCP_FILESYSTEM_ENABLED=true
MCP_FILESYSTEM_ROOT=/app/files/uploads

# Model Configuration (can be shared)
ROUTER_MODEL=gpt-5-mini
PLANNER_MODEL=gemini-2.5-pro
WORKER_MODEL=sonnet-4

# Note: All sensitive API keys and tokens should be in .env.local
# See .env.example for full list of available configuration options