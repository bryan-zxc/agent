# Agent System Environment Configuration
# ===========================================
# This file documents all available environment variables.
# 
# Setup Instructions:
# 1. Copy needed values to .env for shared defaults
# 2. Copy sensitive values to .env.local for API keys and local overrides
# 3. Never commit .env.local to version control
#
# Loading Order (later overrides earlier):
# 1. .env (shared defaults)
# 2. .env.local (sensitive data & personal overrides)

# ==============================================================================
# API KEYS (Put in .env.local)
# ==============================================================================
# LLM Provider API Keys - Required for AI functionality
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx

# ==============================================================================
# SERVER CONFIGURATION (Can go in .env)
# ==============================================================================
# Backend server port
BACKEND_PORT=8001

# Frontend server port
FRONTEND_PORT=3000

# API URLs for frontend-backend communication
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL Configuration (defaults can go in .env)
POSTGRES_HOST=postgres  # Docker service name, or localhost for local PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=agent_user
POSTGRES_DB=agent_main

# PostgreSQL Password (MUST go in .env.local - never commit!)
POSTGRES_PASSWORD=your_secure_password_here

# Enable automatic database migrations on startup
DATABASE_AUTO_MIGRATE=true

# Project-specific database (for multi-project setup)
PROJECT_NAME=default
PROJECT_DATABASE=default_db

# ==============================================================================
# ENVIRONMENT SETTINGS (Can go in .env)
# ==============================================================================
# Environment name: development, staging, production
ENVIRONMENT=development

# Enable debug logging
DEBUG_MODE=false

# ==============================================================================
# MODEL CONFIGURATION (Can go in .env)
# ==============================================================================
# Models used by different agents
ROUTER_MODEL=gpt-5-mini
PLANNER_MODEL=gemini-2.5-pro
WORKER_MODEL=sonnet-4

# ==============================================================================
# MCP (MODEL CONTEXT PROTOCOL) CONFIGURATION
# ==============================================================================

# --- Global MCP Settings (Can go in .env) ---
# Enable/disable MCP integration globally
MCP_ENABLED=true

# Enable MCP for specific agent types
MCP_ROUTER_ENABLED=true    # Router can use MCP tools
MCP_PLANNER_ENABLED=true    # Planner can use MCP tools
MCP_WORKER_ENABLED=false    # Workers can use MCP tools (not yet implemented)

# --- MCP Server Credentials (Put in .env.local) ---
# GitHub Personal Access Token for MCP GitHub integration
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, workflow (if managing actions)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- MCP Filesystem Server (Can go in .env or override in .env.local) ---
# Enable filesystem access via MCP
MCP_FILESYSTEM_ENABLED=true

# Root directory for filesystem MCP server (security boundary)
# Use absolute path for production, can override in .env.local for local dev
MCP_FILESYSTEM_ROOT=/workspace

# --- Custom MCP Servers (Put in .env.local if contains secrets) ---
# Define additional MCP servers as JSON array
# Format: [{"name":"custom","server_type":"http","url":"http://localhost:8000","env":{"API_KEY":"secret"}}]
# MCP_CUSTOM_SERVERS='[{"name":"slack","server_type":"stdio","command":"npx","args":["@modelcontextprotocol/server-slack"],"env":{"SLACK_TOKEN":"xoxb-xxx"}}]'

# ==============================================================================
# NOTES ON CONFIGURATION STRATEGY
# ==============================================================================
# 
# Put in .env (committed to repo):
# - Non-sensitive defaults
# - Feature flags
# - Port numbers
# - Model selections
# - File paths that work for everyone
# 
# Put in .env.local (never committed):
# - API keys and tokens
# - Personal workspace paths
# - Database credentials
# - Custom server configurations with secrets
# - Local development overrides
#
# Use mcp_config.yaml for:
# - Complex MCP server configurations
# - Team-shared MCP setups
# - Server definitions that don't change often